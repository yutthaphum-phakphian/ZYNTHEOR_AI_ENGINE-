{
  "compilerOptions": {
    "target": "ES2022", "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext", "moduleResolution": "Bundler", "jsx": "react-jsx",
    "strict": true, "skipLibCheck": true, "esModuleInterop": true,
    "allowImportingTsExtensions": true, "noEmit": true, "allowJs": true,
    "resolveJsonModule": true, "types": ["vite/client", "node"]
  },
  "include": ["src", "server.ts", "vite.config.ts", "lib", "database"]
}
