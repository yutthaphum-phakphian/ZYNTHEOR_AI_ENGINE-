DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require
PG_POOL_MAX=10
PGSSLMODE=require
COOKIE_SECURE=true
# Set only to a real disposable PostgreSQL database with P1/P2 migrations applied.
# P2_TEST_DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/TEST_DATABASE?sslmode=require
GEMINI_MODEL=
HOST=127.0.0.1
TENANT_STORAGE_HMAC_SECRET=
ZYNTHEOR_ACCESS_TOKEN=
ZYNTHEOR_LOCAL_ONLY=true
ZYNTHEOR_MODEL_API_KEY=
ZYNTHEOR_MODEL_BASE_URL=
ZYNTHEOR_MODEL_NAME=
ZYNTHEOR_PROVIDER=
