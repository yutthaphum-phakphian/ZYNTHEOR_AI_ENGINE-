{
  "name": "zyntheor-ai-engine-clean-rebuild",
  "version": "1.2.2",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "PORT=3000 HOST=0.0.0.0 tsx server.ts",
    "build": "tsc --noEmit && vite build",
    "start": "node scripts/production-start.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "tsc --noEmit",
    "test": "node --import tsx --test tests/*.test.mjs tests/buffalo-0.17-real.test.ts tests/patch-security-regression.test.ts tests/system-diagnostics.test.ts tests/truth-enforcement-boundary.test.ts tests/truth-kernel.test.ts && vitest run",
    "test:vitest": "vitest run",
    "test:mock": "node --import tsx --test tests/*.test.mjs tests/buffalo-0.17-real.test.ts tests/patch-security-regression.test.ts tests/system-diagnostics.test.ts tests/truth-enforcement-boundary.test.ts tests/truth-kernel.test.ts && vitest run",
    "test:real": "ZYNTHEOR_LIVE_INFERENCE=1 node --import tsx --test tests/model-gateway-live.test.mjs",
    "check:env": "node scripts/preflight.mjs",
    "audit:quarantine": "node scripts/audit-quarantine-legacy.mjs",
    "verify": "npm run check:env && npm run typecheck && npm test && npm run build",
    "native:cpu:hardware": "python3 training/native_cpu/train_native_cpu.py hardware",
    "native:cpu:validate": "python3 training/native_cpu/train_native_cpu.py validate",
    "native:cpu:train": "python3 training/native_cpu/train_native_cpu.py train",
    "native:cpu:test": "python3 -m unittest discover -s tests/native_cpu -v",
    "native:cpu:evaluate": "python3 training/native_cpu/train_native_cpu.py evaluate",
    "corex:p17:probe": "python3 training/native_cpu/native_runtime.py probe",
    "corex:p17:generate": "python3 training/native_cpu/native_runtime.py generate --stdin",
    "corex:p18:verify": "node scripts/corex-lifecycle.mjs verify",
    "corex:p18:register": "node scripts/corex-lifecycle.mjs register",
    "corex:p19:preflight": "python3 scripts/sovereign_infra.py preflight",
    "corex:p19:backup": "python3 scripts/sovereign_infra.py backup",
    "corex:p19:restore-verify": "python3 scripts/sovereign_infra.py verify-restore",
    "corex:p20:status": "node lib/corex-platform-gate.mjs",
    "corex:p13:test": "node --test tests/multi-agent-coordinator.test.mjs",
    "db:migrate": "node scripts/db-migrate.mjs up",
    "db:rollback": "node scripts/db-migrate.mjs down",
    "db:identity:dry-run": "node scripts/migrate-identity-json.mjs",
    "db:identity:apply": "node scripts/migrate-identity-json.mjs --apply",
    "db:preflight": "node scripts/postgres-preflight.mjs",
    "test:p1": "node --test tests/postgres-foundation.test.mjs",
    "test:p2": "node --test tests/postgres-identity-p2.test.mjs",
    "test:p3": "node --test tests/postgres-p3-preflight.test.mjs"
  },
  "dependencies": {
    "@google/genai": "^2.31.0",
    "@tailwindcss/vite": "^4.3.4",
    "d3": "^7.9.0",
    "drizzle-orm": "^0.45.4",
    "express": "^5.1.0",
    "lucide-react": "^0.468.0",
    "pg": "^8.23.1",
    "prismjs": "^1.30.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "recharts": "^3.10.1",
    "tailwindcss": "^4.3.4",
    "tsx": "^4.20.3",
    "typescript": "^5.8.3"
  },
  "devDependencies": {
    "@types/d3": "^7.4.3",
    "@types/express": "^5.0.3",
    "@types/node": "^22.15.30",
    "@types/pg": "^8.23.1",
    "@types/prismjs": "^1.26.6",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.7",
    "@vitejs/plugin-react": "^4.7.0",
    "vite": "^6.4.5",
    "vitest": "^5.0.5"
  }
}