{
  "name": "zyntheor-ai-engine-clean-rebuild",
  "version": "1.2.2",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "funding": {
    "type": "github",
    "url": "https://github.com/sponsors/yutthaphum-phakphian"
  },
  "scripts": {
    "dev": "PORT=3000 HOST=0.0.0.0 tsx server.ts",
    "build": "tsc --noEmit && vite build",
    "start": "node scripts/production-start.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "tsc --noEmit",
    "test": "node --import tsx --test tests/*.test.mjs tests/buffalo-0.17-real.test.ts tests/patch-security-regression.test.ts tests/system-diagnostics.test.ts tests/truth-enforcement-boundary.test.ts tests/truth-kernel.test.ts && vitest run",
    "test:agent": "tsx scripts/test-agent-health.ts",
    "test:vitest": "vitest run",
    "test:mock": "node --import tsx --test tests/*.test.mjs tests/buffalo-0.17-real.test.ts tests/patch-security-regression.test.ts tests/system-diagnostics.test.ts tests/truth-enforcement-boundary.test.ts tests/truth-kernel.test.ts && vitest run",
    "test:real": "ZYNTHEOR_LIVE_INFERENCE=1 node --import tsx --test tests/model-gateway-live.test.mjs",
    "check:env": "node scripts/preflight.mjs",
    "audit:quarantine": "node scripts/audit-quarantine-legacy.mjs",
    "verify": "npm run check:env && npm run typecheck && npm test && npm run build",
    "native:hardware:audit": "python3 zyntheor_p5_1_hardened.py --phase hardware",
    "native:tokenizer:train": "python3 zyntheor_p5_1_hardened.py --phase tokenizer",
    "native:dataset:validate": "python3 zyntheor_p5_1_hardened.py --phase dataset",
    "native:train:5m:cpu": "python3 zyntheor_p5_1_hardened.py --phase train",
    "native:eval:5m": "python3 zyntheor_p5_1_hardened.py --phase test",
    "native:checkpoint:verify": "python3 zyntheor_p5_1_hardened.py --phase test"
  },
  "dependencies": {
    "@google/genai": "^2.31.0",
    "@xenova/transformers": "^2.17.2",
    "d3": "^7.9.0",
    "dockerode": "^5.0.1",
    "drizzle-orm": "^0.45.4",
    "express": "^5.1.0",
    "lucide-react": "^0.468.0",
    "prismjs": "^1.30.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "recharts": "^3.10.1",
    "ts-morph": "^28.0.0",
    "tsx": "^4.20.3",
    "typescript": "^5.8.3",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/d3": "^7.4.3",
    "@types/dockerode": "^4.0.2",
    "@types/express": "^5.0.3",
    "@types/node": "^22.15.30",
    "@types/prismjs": "^1.26.6",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.7",
    "@vitejs/plugin-react": "^4.7.0",
    "esbuild": "^0.25.0",
    "vite": "^5.4.19",
    "vitest": "^5.0.5"
  },
  "overrides": {
    "canvas": "^3.1.0"
  }
}
